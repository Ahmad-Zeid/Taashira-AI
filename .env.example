# Copy to .env for local development. Cloud Run sets these itself.
GOOGLE_CLOUD_PROJECT=taashira-506919
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini 3.5 is served from the global endpoint, not a regional one.
TAASHIRA_MODEL=gemini-3.5-flash
TAASHIRA_FAST_MODEL=gemini-3.5-flash-lite
TAASHIRA_MODEL_LOCATION=global

# Set to 0 to run entirely in memory, with no cloud credentials.
TAASHIRA_USE_FIRESTORE=1
